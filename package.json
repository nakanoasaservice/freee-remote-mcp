{
	"name": "freee-remote-mcp",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vp test run",
		"cf-typegen": "wrangler types",
		"check:fix": "vp check --fix",
		"check": "vp check",
		"build": "vp run build:worker",
		"build:worker": "wrangler deploy --dry-run --outdir dist"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.3.0",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"hono": "^4.12.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.4",
		"@types/node": "^25.5.0",
		"typescript": "^5.5.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.73.0"
	},
	"packageManager": "pnpm@12.21.0",
	"cloudflare": {
		"bindings": {
			"FREEE_CLIENT_ID": {
				"description": "freee OAuth アプリの [クライアント ID](https://secure.freee.co.jp/oauth/applications) を入力"
			},
			"FREEE_CLIENT_SECRET": {
				"description": "freee OAuth アプリの [クライアントシークレット](https://secure.freee.co.jp/oauth/applications) を入力"
			},
			"WORKER_URL": {
				"description": "デプロイ後の Worker URL（例: https://freee-remote-mcp.xxx.workers.dev）。末尾スラッシュなし"
			}
		}
	}
}
